# ==============================================================================
# BIZORA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Never commit live secrets to git.
# ==============================================================================

# Runtime Environment (development | test | production)
NODE_ENV=development
PORT=3000

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connectivity (PostgreSQL 16+ on Neon Serverless)
# Format: postgres://user:password@endpoint-pooler.region.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://demo_user:demo_password@ep-demo-pooler.us-east-1.aws.neon.tech/bizora_dev?sslmode=require

# Authentication & Session Security (iron-session AES-256-GCM)
# Must be at least 32 characters in production. Generate with: openssl rand -base64 32
SESSION_SECRET=change_me_to_at_least_32_random_characters_for_session_encryption

# Redis Queue & Caching (BullMQ on Upstash or Managed Redis)
# Format: redis://default:token@region.upstash.io:6379 or rediss://...
REDIS_URL=redis://localhost:6379

# AI Gateway API Credentials (Vercel AI SDK)
# Claude 3.5 Sonnet (Primary) & Gemini 1.5 Pro (Fallback)
ANTHROPIC_API_KEY=sk-ant-demo-placeholder-key
GEMINI_API_KEY=AIzaSyDemo-placeholder-key

# Centralized Cloud Object Storage (Cloudflare R2 / AWS S3 API Compatible)
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=demo_access_key
STORAGE_SECRET_KEY=demo_secret_key
STORAGE_BUCKET_NAME=bizora-imports-dev
