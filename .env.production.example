# ==============================================================================
# BIZORA PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Security Notice: Inject these values securely via your production secrets manager
# (AWS Secrets Manager, GCP Secret Manager, Vault, or Cloud Run Environment Variables).
# DO NOT store plaintext production secrets in Git.
# ==============================================================================

# Core Application Runtime
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://app.bizora.io

# PostgreSQL 16+ Production Connection String (with SSL enforce and pooled connection)
# Format: postgresql://[user]:[password]@[host]:5432/[db]?sslmode=require&pgbouncer=true
DATABASE_URL=postgresql://bizora_prod_app:REPLACE_WITH_SECURE_PASSWORD@prod-pg-pooler.internal:5432/bizora_prod?sslmode=require

# Cryptographic Session Encryption Secret (AES-256-GCM authenticated encryption)
# Generate with: openssl rand -base64 48
SESSION_SECRET=REPLACE_WITH_MINIMUM_48_CHAR_CRYPTOGRAPHICALLY_RANDOM_SECRET

# Shared Redis 7+ Cache & Queue Bus
# Format: rediss://default:[token]@[host]:6379 (TLS enabled)
REDIS_URL=rediss://default:REPLACE_WITH_REDIS_PASSWORD@prod-redis.internal:6379

# Production LLM API Gateways (Encrypted server-side only)
ANTHROPIC_API_KEY=REPLACE_WITH_PRODUCTION_ANTHROPIC_API_KEY
GEMINI_API_KEY=REPLACE_WITH_PRODUCTION_GEMINI_API_KEY

# Cloud Object Storage (S3 / Cloudflare R2 for File Imports & Exports)
STORAGE_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=REPLACE_WITH_R2_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_WITH_R2_SECRET_KEY
STORAGE_BUCKET_NAME=bizora-prod-secure-imports
STORAGE_REGION=auto

# Application Observability & Telemetry (Optional Datadog / Sentry / OpenTelemetry)
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
